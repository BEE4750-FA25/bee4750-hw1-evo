      "source": [
        "function multiple_return_values(x, y)\n",
        "    # Material balance equation\n",
        "    # 100 .- 0.8x .- y + 0.005.*y.^2\n",
        "\n",
        "    # Finance cost equation\n",
        "    # C1 = x.^2/20\n",
        "    # C2 = 1.5.*y\n",
        "    # C = C1 + C2\n",
        "    return (100 .- 0.8x .- y + 0.005.*y.^2, x.^2/20 .+ 1.5.*y) # Return YUK output and financial cost\n",
        "end\n",
        "\n",
        "d = Dirichlet(1,1000) # Dirichlet distribution vector\n",
        "samples_x = rand(1000) # X1 random samples\n",
        "samples_y = rand(1000) # X2 random samples\n",
        "@show samples_x;\n",
        "@show samples_y;\n",
        "\n",
        "output = multiple_return_values.(samples_x, samples_y)\n",
        "M = [out[1] for out in output] # Display YUK output in kg/day\n",
        "C = [out[2] for out in output] # Display financial cost\n",
        "@show M;\n",
        "@show C;"
      ]
